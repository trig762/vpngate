[Unit]
Description=VPN gateway policy routing
After=network-pre.target nftables.service
Before=awg-quick@awg0.service
Wants=nftables.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/vpngate-policy start
ExecStop=/usr/local/libexec/vpngate-policy down
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
