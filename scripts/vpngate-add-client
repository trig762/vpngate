#!/usr/bin/env bash
set -Eeuo pipefail

readonly SETTINGS=/etc/vpngate/settings

validate_public_host() {
  python3 - "$1" <<'PY'
import ipaddress
import re
import sys

value = sys.argv[1]
if not value or value != value.strip():
    raise SystemExit("Host must not be empty or contain surrounding whitespace")
if "%" in value:
    raise SystemExit("Scoped IPv6 addresses are not valid public endpoints")

if value.startswith("[") or value.endswith("]"):
    if not (value.startswith("[") and value.endswith("]")):
        raise SystemExit("IPv6 addresses must use matching brackets")
    value = value[1:-1]

try:
    address = ipaddress.ip_address(value)
except ValueError:
    host = value[:-1] if value.endswith(".") else value
    if len(host) > 253 or not host:
        raise SystemExit("Hostname is empty or too long")
    if all(part.isdigit() for part in host.split(".")):
        raise SystemExit("Invalid IPv4 address")
    label = re.compile(r"^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$")
    if any(not label.fullmatch(part) for part in host.split(".")):
        raise SystemExit("Invalid DNS hostname")
    print(host.lower())
else:
    print(f"[{address.compressed}]" if address.version == 6 else address.compressed)
PY
}

if [[ ${1:-} == --validate-public-host ]]; then
  [[ $# -eq 2 ]] || { echo "Usage: $0 --validate-public-host HOST" >&2; exit 2; }
  validate_public_host "$2"
  exit
fi

[[ $# -eq 0 ]] || { echo "Usage: $0 [--validate-public-host HOST]" >&2; exit 2; }
[[ $EUID -eq 0 ]] || { echo "Run with sudo." >&2; exit 1; }
[[ -r $SETTINGS ]] || { echo "Missing $SETTINGS" >&2; exit 1; }
# shellcheck disable=SC1090
. "$SETTINGS"

readonly server_file="/etc/wireguard/wg0.conf"
readonly client_dir="/etc/vpngate/clients"
[[ -r $server_file ]] || { echo "Missing $server_file" >&2; exit 1; }
[[ -d $client_dir ]] || { echo "Missing $client_dir" >&2; exit 1; }

read -r -p "Client name: " client_name
[[ $client_name =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$ ]] || { echo "Use letters, digits, dot, underscore or dash." >&2; exit 1; }
read -r -p "Client IPv4 address (for example 10.66.66.2): " client_ip
python3 - "$client_ip" "$WG_NETWORK" <<'PY'
import ipaddress, sys
address = ipaddress.IPv4Address(sys.argv[1])
network = ipaddress.IPv4Network(sys.argv[2])
if address not in network or address in (network.network_address, network.broadcast_address):
    raise SystemExit("Address is not a usable member of the wg0 network")
PY

client_file="${client_dir}/${client_name}.conf"
[[ ! -e $client_file ]] || { echo "Client already exists: $client_file" >&2; exit 1; }
read -r -p "Public endpoint clients use (host or IP): " public_host
public_host=$(validate_public_host "$public_host") || exit 1

exec 9>/run/lock/vpngate-add-client.lock
flock -n 9 || { echo "Another vpngate-add-client process is running." >&2; exit 1; }

[[ ! -e $client_file ]] || { echo "Client already exists: $client_file" >&2; exit 1; }
python3 - "$client_ip" "$server_file" <<'PY'
import ipaddress
import re
import sys

requested = ipaddress.IPv4Address(sys.argv[1])
with open(sys.argv[2], encoding="utf-8") as config:
    for line in config:
        match = re.match(r"\s*AllowedIPs\s*=\s*(.*?)(?:\s*#.*)?$", line)
        if not match:
            continue
        for item in match.group(1).split(","):
            try:
                network = ipaddress.ip_network(item.strip(), strict=False)
            except ValueError:
                continue
            if requested in network:
                raise SystemExit("That address is already assigned by an existing AllowedIPs entry.")
PY

umask 077
client_private=$(wg genkey)
client_public=$(printf '%s' "$client_private" | wg pubkey)
psk=$(wg genpsk)

server_candidate=""
server_rollback=""
client_candidate=""
candidate_stripped=""
original_stripped=""
live_changed=0
server_replaced=0
client_committed=0

cleanup() {
  local status="$1" rollback_failed=0 path
  trap - EXIT INT TERM
  if (( status != 0 )); then
    if (( server_replaced )); then
      if ! mv -f -- "$server_rollback" "$server_file"; then
        echo "WARNING: failed to restore ${server_file}; backup remains at ${server_rollback}." >&2
        rollback_failed=1
      fi
    fi
    if (( client_committed )); then
      if ! rm -f -- "$client_file"; then
        echo "WARNING: failed to remove partially committed ${client_file}." >&2
        rollback_failed=1
      fi
    fi
    if (( live_changed )); then
      if ! wg syncconf "$WG_IF" "$original_stripped"; then
        echo "WARNING: automatic rollback of live ${WG_IF} failed." >&2
        rollback_failed=1
      fi
    fi
    if (( rollback_failed )); then
      echo "Client creation failed and rollback needs manual attention." >&2
    else
      echo "Client creation failed; configuration changes were rolled back." >&2
    fi
  fi
  for path in "$server_candidate" "$client_candidate" "$candidate_stripped" "$original_stripped"; do
    [[ -z $path ]] || rm -f -- "$path" || true
  done
  if [[ -n $server_rollback ]] && (( status == 0 || server_replaced == 0 || rollback_failed == 0 )); then
    rm -f -- "$server_rollback" || true
  fi
  exit "$status"
}
trap 'cleanup "$?"' EXIT
trap 'exit 130' INT TERM

server_candidate=$(mktemp "${server_file}.tmp.XXXXXX")
server_rollback=$(mktemp "${server_file}.rollback.XXXXXX")
client_candidate=$(mktemp "${client_dir}/.${client_name}.conf.tmp.XXXXXX")
candidate_stripped=$(mktemp /run/vpngate-wg0-candidate.XXXXXX)
original_stripped=$(mktemp /run/vpngate-wg0-original.XXXXXX)

cp --preserve=mode,ownership -- "$server_file" "$server_candidate"
cp --preserve=mode,ownership -- "$server_file" "$server_rollback"

cat >>"$server_candidate" <<EOF

# client: ${client_name}
[Peer]
PublicKey = ${client_public}
PresharedKey = ${psk}
AllowedIPs = ${client_ip}/32
EOF

cat >"$client_candidate" <<EOF
[Interface]
PrivateKey = ${client_private}
Address = ${client_ip}/32
DNS = ${WG_DNS}

[Peer]
PublicKey = ${WG_PUBLIC_KEY}
PresharedKey = ${psk}
AllowedIPs = 0.0.0.0/0
Endpoint = ${public_host}:${WG_PORT}
PersistentKeepalive = 25
EOF

wg-quick strip "$server_file" >"$original_stripped"
wg-quick strip "$server_candidate" >"$candidate_stripped"
wg show "$WG_IF" >/dev/null
wg syncconf "$WG_IF" "$candidate_stripped"
live_changed=1

mv -f -- "$server_candidate" "$server_file"
server_replaced=1
mv -- "$client_candidate" "$client_file"
client_committed=1

printf '\nCreated %s\n\n' "$client_file"
qrencode -t ansiutf8 <"$client_file" || true
