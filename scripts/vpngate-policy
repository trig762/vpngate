#!/usr/bin/env bash
set -Eeuo pipefail

readonly SETTINGS=/etc/vpngate/settings
[[ -r $SETTINGS ]] || { echo "Missing $SETTINGS" >&2; exit 1; }
# shellcheck disable=SC1090
. "$SETTINGS"

start() {
  ip -4 rule del priority "$RULE_PRIORITY" 2>/dev/null || true
  ip -4 rule add priority "$RULE_PRIORITY" fwmark "${MARK}/0xff" table "$ROUTE_TABLE"
  ip -4 route flush table "$ROUTE_TABLE" 2>/dev/null || true
  ip -4 route add unreachable default metric 42760 table "$ROUTE_TABLE"
}

awg_up() {
  ip -4 route del default dev "$AWG_IF" table "$ROUTE_TABLE" 2>/dev/null || true
  ip -4 route add default dev "$AWG_IF" metric 10 table "$ROUTE_TABLE"
}

awg_down() {
  ip -4 route del default dev "$AWG_IF" table "$ROUTE_TABLE" 2>/dev/null || true
}

down() {
  ip -4 rule del priority "$RULE_PRIORITY" 2>/dev/null || true
  ip -4 route flush table "$ROUTE_TABLE" 2>/dev/null || true
}

case "${1:-}" in
  start) start ;;
  awg-up) awg_up ;;
  awg-down) awg_down ;;
  down) down ;;
  *) echo "Usage: $0 {start|awg-up|awg-down|down}" >&2; exit 2 ;;
esac
