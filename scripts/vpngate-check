#!/usr/bin/env bash
set -uo pipefail

readonly HANDSHAKE_MAX_AGE="${HANDSHAKE_MAX_AGE:-180}"
readonly DNS_TEST_DOMAIN="${DNS_TEST_DOMAIN:-telegram.org}"
readonly -a DIAGNOSTIC_COUNTERS=(
  restored_forward_mark restored_local_mark
  marked_domain_forward marked_static_forward
  marked_domain_local marked_static_local
  redirected_dns_udp redirected_dns_tcp
)

failures=0
handshake_summary=""
dns_test_ip=""
pass() { printf '[OK]   %s\n' "$*"; }
fail() { printf '[FAIL] %s\n' "$*"; failures=$((failures + 1)); }
check() { local label="$1"; shift; if "$@" >/dev/null 2>&1; then pass "$label"; else fail "$label"; fi; }

recent_awg_handshakes() {
  local now peer timestamp age max_age peers=0 stale=0
  [[ $HANDSHAKE_MAX_AGE =~ ^[0-9]+$ ]] || return 1
  max_age=$((10#$HANDSHAKE_MAX_AGE))
  now=$(date +%s)
  while read -r peer timestamp; do
    [[ -n ${peer:-} ]] || continue
    peers=$((peers + 1))
    if [[ ! ${timestamp:-} =~ ^[0-9]+$ ]] || (( timestamp == 0 )); then
      handshake_summary+="${peer:0:12}: never; "
      stale=1
      continue
    fi
    age=$((now - timestamp))
    (( age < 0 )) && age=0
    handshake_summary+="${peer:0:12}: ${age}s ago; "
    (( age <= max_age )) || stale=1
  done < <(awg show "$AWG_IF" latest-handshakes 2>/dev/null)
  (( peers > 0 && stale == 0 ))
}

dns_populates_dynamic_set() {
  dns_test_ip=$(getent ahostsv4 "$DNS_TEST_DOMAIN" 2>/dev/null | awk 'NR == 1 { print $1 }')
  [[ $dns_test_ip =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
  nft get element inet vpngate vpn_domains4 "{ $dns_test_ip }" >/dev/null 2>&1
}

static_set_has_elements() {
  nft list set inet vpngate vpn_static4 2>/dev/null | grep -Eq 'elements[[:space:]]*=[[:space:]]*\{[^}]'
}

diagnostic_counters_exist() {
  local counter
  for counter in "${DIAGNOSTIC_COUNTERS[@]}"; do
    nft list counter inet vpngate "$counter" >/dev/null 2>&1 || return 1
  done
}

show_diagnostic_counters() {
  local counter values
  printf '\nPolicy/DNS counters:\n'
  for counter in "${DIAGNOSTIC_COUNTERS[@]}"; do
    values=$(nft list counter inet vpngate "$counter" 2>/dev/null | \
      sed -nE 's/.*packets ([0-9]+) bytes ([0-9]+).*/packets \1, bytes \2/p' | head -n 1)
    printf '  %-24s %s\n' "$counter" "${values:-unavailable}"
  done
}

check "IPv4 forwarding enabled" test "$(sysctl -n net.ipv4.ip_forward 2>/dev/null)" = 1
check "wg0 exists" ip link show wg0
check "awg0 exists" ip link show awg0
check "nftables ruleset is valid" nft --check --file /etc/nftables.conf
check "vpngate table loaded" nft list table inet vpngate
check "dnsmasq configuration valid" dnsmasq --test
check "dnsmasq active" systemctl is-active --quiet dnsmasq
check "system resolver active" systemctl is-active --quiet systemd-resolved
check "fwmark rule installed" sh -c "ip -4 rule show | grep -q 'fwmark 0x64.*lookup 100'"
check "table 100 default route installed" sh -c "ip -4 route show table 100 | grep -q '^default dev awg0'"
check "table 100 fail-closed route installed" sh -c "ip -4 route show table 100 | grep -q '^unreachable default'"
check "main table remains on WAN" sh -c "! ip -4 route show table main | grep -q '^default dev awg0'"
check "marked route uses awg0" sh -c "ip -4 route get 149.154.167.99 mark 0x64 | grep -q 'dev awg0'"
check "AmneziaWG peer configured" sh -c "awg show awg0 peers | grep -q ."
check "AmneziaWG handshake is at most ${HANDSHAKE_MAX_AGE}s old" recent_awg_handshakes
[[ -z $handshake_summary ]] || printf '       %s\n' "${handshake_summary%; }"
check "DNS resolves ${DNS_TEST_DOMAIN} into vpn_domains4" dns_populates_dynamic_set
[[ -z $dns_test_ip ]] || printf '       %s -> %s\n' "$DNS_TEST_DOMAIN" "$dns_test_ip"
check "vpn_static4 contains installed prefixes" static_set_has_elements
check "policy and DNS diagnostic counters exist" diagnostic_counters_exist

show_diagnostic_counters

printf '\nWireGuard server:\n'
wg show wg0 2>/dev/null || true
printf '\nAmneziaWG client:\n'
awg show awg0 2>/dev/null || true

if (( failures > 0 )); then
  printf '\n%d check(s) failed.\n' "$failures" >&2
  exit 1
fi
printf '\nAll checks passed.\n'
